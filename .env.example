# Configuration Skyjo Manager
# Copier ce fichier en .env et modifier les valeurs

# Flask Secret Key (OBLIGATOIRE)
# Générer une clé aléatoire avec : python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET=change_this_to_a_random_secret_key_at_least_32_characters_long

# OneDrive Export Path (OPTIONNEL)
# Décommenter et configurer si vous voulez l'export automatique vers OneDrive
# ONEDRIVE_PATH=/chemin/vers/votre/dossier/onedrive
